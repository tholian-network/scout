FROM almalinux:9-minimal

RUN microdnf -y install \
        httpd \
        ca-certificates \
    && microdnf clean all

RUN mkdir -p /var/cache/e2e \
    && for pkg in httpd httpd-core httpd-tools mod_lua; do \
        curl -fsSL -o "/var/cache/e2e/$pkg-old.rpm" \
            "https://repo.almalinux.org/vault/9.4/AppStream/x86_64/os/Packages/$pkg-2.4.57-11.el9_4.1.x86_64.rpm" || exit 1; \
    done \
    && curl -fsSL -o /var/cache/e2e/httpd-filesystem-old.rpm \
        'https://repo.almalinux.org/vault/9.4/AppStream/x86_64/os/Packages/httpd-filesystem-2.4.57-11.el9_4.1.noarch.rpm' \
    && { microdnf -y remove mod_http2 || true; }

RUN rpm -U --oldpackage --replacepkgs /var/cache/e2e/*.rpm

RUN printf 'e2e-rpm\n' > /etc/machine-id \
    && ln -snf /usr/share/zoneinfo/UTC /etc/localtime

ENV E2E_PACKAGE=httpd-core
ENV E2E_SERVICE=httpd
ENV E2E_OLD_VERSION=2.4.57-11.el9_4.1
ENV E2E_PACKAGE_MANAGER=rpm
ENV E2E_RESET=/bin/true

CMD ["/tests/e2e", "-test.v"]
