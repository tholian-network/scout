FROM fedora:43

RUN dnf -y install \
        httpd \
        ca-certificates \
        curl \
        coreutils \
        procps-ng \
    && dnf clean all

RUN mkdir -p /var/cache/e2e \
    && for pkg in httpd httpd-core httpd-tools mod_lua; do \
        curl -fsSL -o "/var/cache/e2e/$pkg-old.rpm" \
            "https://kojipkgs.fedoraproject.org/packages/httpd/2.4.63/4.fc43/x86_64/$pkg-2.4.63-4.fc43.x86_64.rpm" || exit 1; \
    done \
    && curl -fsSL -o /var/cache/e2e/httpd-filesystem-old.rpm \
        'https://kojipkgs.fedoraproject.org/packages/httpd/2.4.63/4.fc43/noarch/httpd-filesystem-2.4.63-4.fc43.noarch.rpm' \
    && rpm -U --oldpackage --replacepkgs /var/cache/e2e/*.rpm \
    && dnf makecache

RUN printf 'e2e-fedora\n' > /etc/machine-id \
    && ln -snf /usr/share/zoneinfo/UTC /etc/localtime

COPY e2e-tests/fedora/entrypoint.sh /usr/local/bin/e2e-entrypoint
COPY e2e-tests/fedora/reset.sh /usr/local/bin/e2e-reset
RUN chmod +x /usr/local/bin/e2e-entrypoint /usr/local/bin/e2e-reset

ENV E2E_PACKAGE=httpd-core
ENV E2E_SERVICE=httpd
ENV E2E_OLD_VERSION=2.4.63-4.fc43
ENV E2E_PACKAGE_MANAGER=dnf
ENV E2E_RESET=/usr/local/bin/e2e-reset

ENTRYPOINT ["/usr/local/bin/e2e-entrypoint"]
CMD ["/tests/e2e", "-test.v"]
