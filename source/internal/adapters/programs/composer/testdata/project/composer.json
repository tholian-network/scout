{
  "name": "acme/example-service",
  "description": "Example PHP service",
  "version": "1.4.0",
  "homepage": "https://example.com/php-service",
  "type": "project",
  "license": ["MIT"],
  "authors": [
    {
      "name": "Alice Example",
      "email": "alice@example.com",
      "role": "Developer"
    },
    "Bob Example <bob@example.com>"
  ],
  "require": {
    "php": ">=8.2",
    "ext-json": "*",
    "symfony/console": "^6.4",
    "monolog/monolog": "^3.5"
  },
  "require-dev": {
    "ext-xdebug": "*",
    "phpunit/phpunit": "^10.5"
  },
  "conflict": {
    "acme/old-service": "<2.0"
  },
  "replace": {
    "acme/legacy": "self.version"
  },
  "provide": {
    "psr/log-implementation": "1.0"
  }
}
